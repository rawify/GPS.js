{
    "name": "gps",
    "title": "GPS.js",
    "version": "0.9.0",
    "type": "commonjs",
    "description": "Parse NMEA 0183 GPS/GNSS sentences, streams, and navigation state in Node.js or browsers",
    "homepage": "https://raw.org/software/libraries/gps-js/",
    "bugs": "https://github.com/rawify/GPS.js/issues",
    "keywords": [
        "nmea",
        "gps",
        "gnss",
        "glonass",
        "serial",
        "parser",
        "distance",
        "geo",
        "stream",
        "location",
        "rmc",
        "gga",
        "gll",
        "gsa",
        "vtg",
        "gsv",
        "hdt"
    ],
    "private": false,
    "main": "./dist/gps.js",
    "module": "./dist/gps.mjs",
    "browser": "./dist/gps.min.js",
    "unpkg": "./dist/gps.min.js",
    "types": "./dist/gps.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/gps.d.mts",
                "default": "./dist/gps.mjs"
            },
            "require": {
                "types": "./dist/gps.d.ts",
                "default": "./dist/gps.js"
            },
            "default": {
                "types": "./dist/gps.d.ts",
                "default": "./dist/gps.js"
            }
        },
        "./browser": {
            "import": {
                "types": "./dist/gps.d.mts",
                "default": "./dist/gps.min.mjs"
            },
            "default": "./dist/gps.min.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rawify/GPS.js.git"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/rawify"
    },
    "author": {
        "name": "Robert Eisele",
        "email": "robert@raw.org",
        "url": "https://raw.org/"
    },
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "directories": {
        "example": "examples",
        "test": "tests"
    },
    "scripts": {
        "clean": "node scripts/clean.mjs",
        "typecheck": "tsc --noEmit",
        "build:types": "tsc -p tsconfig.build.json",
        "build:js": "node scripts/build.mjs",
        "build": "npm run clean && npm run build:types && npm run build:js",
        "test:types": "tsc -p tests/types/tsconfig.json",
        "test:runtime": "node --test tests/*.test.js",
        "test": "npm run build && npm run test:types && npm run test:runtime",
        "prepublishOnly": "npm test"
    },
    "devDependencies": {
        "angles": "^0.5.1",
        "byline": "^5.0.0",
        "esbuild": "^0.25.12",
        "express": "^5.2.1",
        "kalman": "0.0.2",
        "serialport": "^13.0.0",
        "sylvester": "0.0.21",
        "typescript": "^5.9.3",
        "ws": "^8.21.3"
    }
}
